# Copia este archivo a `.env`. `.env` es la fuente principal: sus valores
# tienen prioridad. Si existe `.ht.env`, solo se usa para completar claves
# ausentes (compatibilidad con instalaciones anteriores). En este servidor
# Apache el acceso HTTP a `.env` está bloqueado y PHP lo lee mediante una ACL.
DB_HOST=127.0.0.1
DB_NAME=jeremy_tech
DB_USER=
DB_PASS=
APP_TIMEZONE=America/Lima
# URL pública usada en enlaces de correos simulados. Si se deja vacía, en web
# se deduce del host de la petición y en CLI se usa http://localhost.
APP_URL=
# Directorio absoluto para los correos simulados. Debe estar FUERA del
# DocumentRoot; con AllowOverride None los .htaccess no protegen nada.
MAIL_STORAGE_PATH=

# Chatbot. Con CHAT_MODE=rules responde solo con reglas locales; con
# CHAT_MODE=ai usa el proveedor indicado si CHAT_API_KEY no está vacía.
CHAT_MODE=rules
CHAT_AI_PROVIDER=gemini
CHAT_API_KEY=
CHAT_MODEL=gemini-3.5-flash

# Pasarela de pagos (Fase 6). Con PAGOS_MODO=simulado el checkout sigue siendo
# la demo. Al definir PAGOS_WEBHOOK_SECRET se activa el endpoint firmado
# ?ruta=pagos/webhook (HMAC-SHA256). No pongas el secreto en el repositorio.
PAGOS_MODO=simulado
PAGOS_PROVEEDOR=externa
PAGOS_WEBHOOK_SECRET=
PAGOS_MONEDA=PEN
