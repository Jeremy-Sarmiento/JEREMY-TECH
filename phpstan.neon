parameters:
    paths:
        - src
    level: 5
    ignoreErrors:
        - "#Offset .* on \\*NEVER\\* on left side of \\?#"
        - '#Offset .* on array\{.*\} on left side of \?\? always exists#'
        - '#Constant .* is unused#'
        - '#Method .* is unused#'
        - '#Static method .* is unused#'
    bootstrapFiles:
        - tests/bootstrap.php
