parameters:
    paths:
        - src
    level: 5
    phpVersion: 80200
    ignoreErrors:
        - "#Offset .* on \\*NEVER\\* on left side of \\?#"
        - '#Offset .* on array\{.*\} on left side of \?\? always exists#'
        - '#Constant .* is unused#'
        - '#Method .* is unused#'
        - '#Strict comparison using === between non-falsy-string and .* will always evaluate to false#'
    bootstrapFiles:
        - tests/bootstrap.php
