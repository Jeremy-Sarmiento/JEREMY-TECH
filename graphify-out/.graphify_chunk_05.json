    {
      "id": "entregables_sesion_003_a3_2_entregable_modelo_operativo_hibrido",
      "label": "Modelo operativo híbrido de Jeremy Tech",
      "file_type": "rationale",
      "source_file": "/srv/http/JEREMY-TECH/entregables/Sesion-003-A3-2-Entregable.pdf",
      "source_location": "pp.1-2",
      "source_url": null,
      "captured_at": null,
      "author": "Jeremy Sarmiento Tapia",
      "contributor": null,
      "rationale": "Jeremy Tech combina B2C como modelo principal —ventas unitarias a estudiantes y familias, boleta, pagos inmediatos y entrega express— con B2B complementario para empresas agroindustriales y colegios, mediante facturación, cotizaciones, lotes, crédito y soporte in situ."
    },
    {
      "id": "entregables_sesion_003_a3_2_entregable_b2c",
      "label": "B2C",
      "file_type": "concept",
      "source_file": "/srv/http/JEREMY-TECH/entregables/Sesion-003-A3-2-Entregable.pdf",
      "source_location": "pp.1-2",
      "source_url": null,
      "captured_at": null,
      "author": "Jeremy Sarmiento Tapia",
      "contributor": null,
      "rationale": "Es el modelo principal: vende celulares, laptops, audífonos y accesorios directamente a estudiantes, familias y particulares de La Joya; maneja boleta, Yape, Plin, tarjeta o contraentrega, pedidos de 1 a 3 unidades, checkout web 24/7, garantía de 12 meses y despacho en menos de dos horas."
    },
    {
      "id": "entregables_sesion_003_a3_2_entregable_b2b",
      "label": "B2B",
      "file_type": "concept",
      "source_file": "/srv/http/JEREMY-TECH/entregables/Sesion-003-A3-2-Entregable.pdf",
      "source_location": "pp.1-2",
      "source_url": null,
      "captured_at": null,
      "author": "Jeremy Sarmiento Tapia",
      "contributor": null,
      "rationale": "Es el modelo complementario para empresas agroindustriales y colegios: usa factura electrónica, transferencia BCP o BBVA, crédito a 30 días, lotes de 5 a más de 30 unidades, cotizaciones PDF, soporte técnico in situ y guía de remisión electrónica."
    },
